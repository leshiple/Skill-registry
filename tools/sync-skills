#!/usr/bin/env python3
"""Создаёт симлинки на группы skills из registry в целевом проекте."""

from pathlib import Path
import os
import re
import subprocess
import sys

PROJECT_ROOT = Path.cwd()
config_file = PROJECT_ROOT / ".skill-registry.yaml"
if not config_file.exists():
    raise SystemExit("Не найден .skill-registry.yaml в целевом проекте")

config_text = config_file.read_text(encoding="utf-8")
config = dict(re.findall(r"^([a-z_]+):\s*(.+)$", config_text, re.MULTILINE))
profile = config.get("profile")
registry = (PROJECT_ROOT / config.get("registry_path", "skill-registry")).resolve()
ais = re.findall(r"^\s+-\s+([^\s#]+)\s*$", config_text.split("ais:", 1)[-1], re.MULTILINE)
ai_paths = {
    "claude": ".claude/skills",
    "cursor": ".cursor/skills",
    "codex": ".agents/skills",
    "deepseek": ".deepseek/skills",
}


def remove_link(path: Path) -> None:
    if path.is_symlink() or (hasattr(path, "is_junction") and path.is_junction()):
        if hasattr(path, "is_junction") and path.is_junction():
            path.rmdir()
        else:
            path.unlink()
        return
    if path.exists():
        raise SystemExit(f"Отказано в замене обычного каталога: {path}")


def create_link(source: Path, destination: Path) -> None:
    if destination.exists() or destination.is_symlink() or (hasattr(destination, "is_junction") and destination.is_junction()):
        remove_link(destination)
    if os.name == "nt":
        result = subprocess.run(
            ["cmd", "/c", "mklink", "/J", str(destination), str(source)],
            capture_output=True,
            text=True,
        )
        if result.returncode:
            raise SystemExit(f"Не удалось создать junction {destination}: {result.stderr.strip()}")
    else:
        destination.symlink_to(Path(os.path.relpath(source, destination.parent)))
manifest = registry / "profiles" / profile / "manifest.yaml"

if not profile or not manifest.exists():
    raise SystemExit(f"Профиль не найден: {profile or '<не указан>'}")

skills = re.findall(r"^\s+-\s+([^\s#]+)\s*$", manifest.read_text(encoding="utf-8"), re.MULTILINE)
groups = sorted({skill.split("/", 1)[0] for skill in skills})
if not ais:
    raise SystemExit("В .skill-registry.yaml не выбран ни один ИИ-инструмент")

for ai in ais:
    if ai not in ai_paths:
        raise SystemExit(f"Неизвестный ИИ-инструмент: {ai}")
    skills_path = PROJECT_ROOT / ai_paths[ai]
    skills_path.mkdir(parents=True, exist_ok=True)
    for group in groups:
        source = registry / "skills" / group
        destination = skills_path / group
        if not source.is_dir():
            raise SystemExit(f"Группа не найдена: {source}")
        create_link(source, destination)
        print(f"Создана ссылка: {destination} -> {source}")

print(f"Синхронизация завершена: {len(groups)} группы для {len(ais)} ИИ-инструментов")
