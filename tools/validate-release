#!/usr/bin/env python3
"""Проверяет условия выпуска версии registry."""

from pathlib import Path
import re
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]


def git(*args: str) -> str:
    result = subprocess.run(["git", *args], cwd=ROOT, text=True, capture_output=True)
    if result.returncode:
        raise SystemExit(result.stderr.strip() or "git завершился с ошибкой")
    return result.stdout.strip()


if len(sys.argv) != 2 or not re.fullmatch(r"v?\d+\.\d+\.\d+", sys.argv[1]):
    raise SystemExit("Использование: tools/validate-release v1.0.4")

version = sys.argv[1].removeprefix("v")
tag = f"v{version}"
changelog = (ROOT / "CHANGELOG.md").read_text(encoding="utf-8")

version_section = re.search(rf"## \[?{re.escape(version)}\]?(.*?)(?=\n## |\Z)", changelog, re.DOTALL)
if not version_section or not re.search(r"^[-*+]\s+\S+", version_section.group(1), re.MULTILINE):
    raise SystemExit(f"CHANGELOG.md: нужна непустая секция [{version}]")

if tag in git("tag", "--list"):
    raise SystemExit(f"Тег уже существует: {tag}")

subprocess.run([sys.executable, str(ROOT / "tools" / "validate-skills")], cwd=ROOT, check=True)
print(f"Проверка релиза {tag} пройдена")
