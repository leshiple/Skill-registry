#!/usr/bin/env python3
"""Единая CLI-точка для работы с registry в целевом проекте."""

from pathlib import Path
import argparse
import curses
import re
import subprocess
import sys

PROJECT_ROOT = Path.cwd()
REGISTRY_ROOT = Path(__file__).resolve().parents[1]
AI_PATHS = {
    "claude": ".claude/skills",
    "cursor": ".cursor/skills",
    "codex": ".agents/skills",
    "deepseek": ".deepseek/skills",
}


def available_profiles() -> list[str]:
    return sorted(path.parent.name for path in (REGISTRY_ROOT / "profiles").glob("*/manifest.yaml"))


def checkbox_select(title: str, options: list[str], multi: bool) -> list[str]:
    if not options:
        raise SystemExit("Нет доступных вариантов выбора")

    def draw(screen: curses.window) -> list[str]:
        curses.curs_set(0)
        screen.keypad(True)
        selected = {0} if not multi else set()
        cursor = 0
        while True:
            screen.erase()
            screen.addstr(0, 0, title)
            screen.addstr(1, 0, "↑/↓ — перемещение   Space — выбрать   Enter — подтвердить   q — выход")
            for index, option in enumerate(options):
                marker = "[x]" if index in selected else "[ ]"
                if not multi:
                    marker = "(*)" if index in selected else "( )"
                style = curses.A_REVERSE if index == cursor else curses.A_NORMAL
                screen.addstr(index + 3, 0, f"{marker} {option}", style)
            screen.refresh()
            key = screen.getch()
            if key in (curses.KEY_UP, ord("k")):
                cursor = (cursor - 1) % len(options)
            elif key in (curses.KEY_DOWN, ord("j")):
                cursor = (cursor + 1) % len(options)
            elif key == ord(" "):
                if multi:
                    selected.symmetric_difference_update({cursor})
                else:
                    selected = {cursor}
            elif key in (curses.KEY_ENTER, 10, 13):
                if selected:
                    return [options[index] for index in sorted(selected)]
            elif key in (ord("q"), 27):
                raise SystemExit("Выбор отменён")

    return curses.wrapper(draw)


def select_profile() -> str:
    profiles = available_profiles()
    return checkbox_select("Выберите профиль", profiles, multi=False)[0]


def select_ais() -> list[str]:
    return checkbox_select("Выберите ИИ-инструменты", list(AI_PATHS), multi=True)


def write_profile(profile: str, ais: list[str]) -> None:
    config_file = PROJECT_ROOT / ".skill-registry.yaml"
    ai_lines = "\n".join(f"  - {name}" for name in ais)
    config_file.write_text(
        f"profile: {profile}\n"
        "registry_path: skill-registry\n"
        "ais:\n"
        f"{ai_lines}\n",
        encoding="utf-8",
    )
    print(f"Конфигурация записана: {config_file} (профиль: {profile}; ИИ: {', '.join(ais)})")


def run(script: str) -> int:
    return subprocess.run([sys.executable, str(REGISTRY_ROOT / "tools" / script)], cwd=PROJECT_ROOT).returncode


parser = argparse.ArgumentParser(description="Управление навыками из skill registry")
subparsers = parser.add_subparsers(dest="command", required=True)

subparsers.add_parser("validate", help="проверить registry")

profile_parser = subparsers.add_parser("profile", help="выбрать и записать профиль проекта")
profile_parser.add_argument("--name", choices=available_profiles(), help="имя профиля без интерактивного выбора")
profile_parser.add_argument("--ai", choices=sorted(AI_PATHS), action="append", dest="ais", help="ИИ-инструмент; можно указать несколько раз")

subparsers.add_parser("sync", help="создать или обновить симлинки навыков")

setup_parser = subparsers.add_parser("setup", help="выбрать профиль и ИИ, создать конфигурацию и симлинки")
setup_parser.add_argument("--profile", choices=available_profiles(), help="профиль без интерактивного выбора")
setup_parser.add_argument("--ai", choices=sorted(AI_PATHS), action="append", dest="ais", help="ИИ-инструмент; можно указать несколько раз")

args = parser.parse_args()

if args.command == "validate":
    raise SystemExit(run("validate-skills"))
if args.command == "profile":
    write_profile(args.name or select_profile(), args.ais or select_ais())
    raise SystemExit(0)
if args.command == "sync":
    raise SystemExit(run("sync-skills"))
if args.command == "setup":
    write_profile(args.profile or select_profile(), args.ais or select_ais())
    raise SystemExit(run("sync-skills"))
